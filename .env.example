# Rename this file to .env and replace YOUR_API_KEY with your actual Gemini API key.
GEMINI_API_KEY="your_gemini_api_key"

# You can optionally change the TTS model used.
# TTS_MODEL=gemini-3.8-flash-tts

# Prebuilt voice name (default: Orus)
# TTS_VOICE=Orus

# Delivery style. Gemini 3.x TTS reads the input text verbatim, so speaking
# instructions must be passed here (sent as part.speechMetadata.style),
# never prepended to the text itself.
# TTS_STYLE=自然で聞きやすいポッドキャスト風の、落ち着いた話し方
